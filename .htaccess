DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /betapodcast/

  # rss.xml et sitemap.xml → scripts PHP
  RewriteRule ^rss\.xml$     public/rss.php     [L,NC]
  RewriteRule ^sitemap\.xml$ public/sitemap.php [L,NC]

  # Fichiers audio → proxy PHP pour comptage des écoutes
  # DOIT être avant la règle "fichier existant" sinon les MP3 sont servis directement
  RewriteRule ^audio/(.+\.(mp3|ogg|m4a|aac|wav|flac|opus|mp4))$ public/audio.php?file=$1 [L,QSA,NC]

  # Fichiers statiques existants (CSS, JS, images) servis directement
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Tout le reste → routeur PHP
  RewriteRule ^ index.php [L]
</IfModule>
